---
// Mise en page commune à toutes les pages : les styles communs — polices, jetons, base, en-tête, pied de page, dans cet ordre —, l'en-tête collant,
// <main> pour la page, le pied de page. Le <title> est « <titre> — Perpetual », ou le titre complet passé par la page (fullTitle).
// noindex sur toutes les pages tant que le réglage `indexation` de data/site.json est faux ; le passer à vrai suffit : le noindex part (sauf sur les
// pages à prop noindex : la 404) et robots.txt s'ouvre (src/pages/robots.txt.ts).
// `page` est posé en data-page sur <html> : des règles en dépendent (html[data-page="engagements"] .page__titre…) ; « texte » pour les pages de
// texte (mentions légales, confidentialité, 404), « collectif » pour Collectif, qui prend le titre en sans léger d'Engagements (src/styles/page.css).
// Adresse et partage : le lien canonique — `site` (astro.config.mjs) puis le chemin sans « .html », comme sitemap.xml ; pas sur les pages en noindex
// permanent —, les balises Open Graph (titre, description, adresse, image de partage 1 200 × 630 et son texte alternatif : src/lib/partage.ts) et la
// carte de partage large (twitter:card). Toutes les adresses suivent `site`.
// Icônes : le SVG pour les navigateurs qui le lisent, un PNG de 32 px pour les autres (déclaré avant, avec sizes : Chrome garde alors le SVG) et
// l'icône d'écran d'accueil d'iOS (180 px), les deux tirées de public/favicon.svg au build (src/lib/icones.ts).
// Menu du téléphone : la classe menu-js est posée sur <html> dès le <head>, avant le premier rendu, pour que l'en-tête du téléphone s'affiche
// d'emblée avec son bouton (sans JavaScript, la navigation reste visible sur deux lignes) ; le menu lui-même est dans SiteHeader.astro.
import '../styles/polices.css';
import '../styles/jetons.css';
import '../styles/base.css';
import '../styles/entete.css';
import '../styles/pied.css';
import site from '../../data/site.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PARTAGE, altPartage } from '../lib/partage';

interface Props {
  title: string;
  /** Vrai quand `title` est le titre complet de l'onglet (pas de « — Perpetual » ajouté). */
  fullTitle?: boolean;
  description?: string;
  /** Entrée de navigation active (son href, ex. « /realisations ») : trait sous le lien de l'en-tête. */
  active?: string;
  /** La page, pour data-page sur <html> (ex. « engagements », « texte ») ; sans valeur, pas d'attribut. */
  page?: string;
  /** Vrai : noindex même une fois l'indexation ouverte (la 404) ; ces pages ne sont pas non plus dans sitemap.xml. */
  noindex?: boolean;
}

const { title, fullTitle = false, description = '', active = '', page, noindex = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} — ${site.name}`;
// l'adresse publique de la page : / pour la Home, /realisations/the-bank pour une fiche (le chemin construit, sans « .html » ni « index »)
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '$1') || '/';
const canonique = new URL(chemin, Astro.site).href;
const image = new URL(PARTAGE.chemin, Astro.site).href;
const imageAlt = await altPartage();
---

<!doctype html>
<html lang="fr" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('menu-js');</script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {(!site.indexation || noindex) && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonique} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={canonique} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(PARTAGE.largeur)} />
    <meta property="og:image:height" content={String(PARTAGE.hauteur)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <SiteHeader active={active} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
