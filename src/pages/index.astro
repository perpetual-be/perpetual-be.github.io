---
import Base from '../layouts/Base.astro';
---

<Base title="Perpetual" description="Perpetual — le trait d'union entre les idées et le capital." noindex>
  <section class="wrap soon">
    <p class="soon-kicker">Actifs depuis 2002</p>
    <h1>Un nouveau site est en préparation.</h1>
    <p class="soon-text">
      En attendant, écrivez-nous&nbsp;: <a href="mailto:julien@perpetual.be">julien@perpetual.be</a>
    </p>
  </section>
</Base>

<style>
  .soon {
    padding-block: clamp(4rem, 15vh, 10rem);
    max-width: var(--measure);
    margin-inline: auto;
  }
  .soon-kicker {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.75rem, 4vw + 0.5rem, 3rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .soon-text { margin: 0; font-size: 1.125rem; }
</style>
