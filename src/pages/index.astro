---
// La Home : en-tête → photo pleine largeur portant l'accroche → bande des quatre chiffres avec les anneaux → deux colonnes de paragraphes et la
// signature → graphique en anneau qui se remplit → carte sous « Réalisations » → pied de page. Les textes viennent de content/home.md
// (src/lib/contenu.ts), la photo du premier écran et le texte de la carte de son en-tête (hero, carte), la carte de data/carte/. Un composant par
// section : src/components/home/.
import Base from '../layouts/Base.astro';
import PremierEcran from '../components/home/PremierEcran.astro';
import Graphique from '../components/home/Graphique.astro';
import Carte from '../components/home/Carte.astro';
import site from '../../data/site.json';
import { lireHome } from '../lib/contenu';
import '../styles/home.css';

const home = await lireHome();
if (!home.hero) throw new Error('content/home.md : hero (la photo du premier écran : photo, focal) manquant dans l’en-tête');
if (!home.portfolio) throw new Error('content/home.md : portfolio (le titre et les parts du graphique) manquant dans l’en-tête');
if (!home.carte) throw new Error('content/home.md : carte (le titre et le paragraphe de la carte des réalisations : title, text) manquante dans l’en-tête');
---

<Base title={`${site.name} — ${site.tagline}`} fullTitle description={home.description}>
  <PremierEcran h1={home.h1} paragraphs={home.paragraphs} signature={home.signature} stats={home.stats} hero={home.hero} />
  <Graphique title={home.portfolio.title} items={home.portfolio.items} />
  <Carte titre={home.carte.title} texte={home.carte.text} />
</Base>
