---
// Mentions légales (lot 6, 01/10/2026) : une page de texte sur le gabarit d'Engagements (choix d'Axel du 01/10) — le titre seul (.page-head, en sans léger),
// puis le registre : une section.rang par titre ## de content/mentions-legales.md, le titre à gauche comme les chapitres des fiches, le Markdown de la
// section à droite, rendu par Astro et mis en forme par le plugin src/lib/rehype-registre.mjs (astro.config.mjs). Aucune entrée active dans l'en-tête.
import Base from '../layouts/Base.astro';
import PageHead from '../components/engagements/PageHead.astro';
import Registre from '../components/engagements/Registre.astro';
import { lirePageTexte } from '../lib/contenu';
import '../styles/page.css';
import '../styles/texte.css';

const page = await lirePageTexte('mentions-legales');
---

<Base title={page.titre} description={page.description} page="texte">
  <PageHead titre={page.titre} />
  <Registre><page.Content /></Registre>
</Base>
