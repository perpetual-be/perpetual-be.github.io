---
// Page de contrôle des photos (lot 4, 01/10/2026) : chaque photo citée par les données (champ selection de data/projects.json), dans l'ordre des
// projets, par le même composant que le site (ProjectPhoto) — AVIF, WebP, JPEG de repli. Construite sur GitHub à chaque déploiement : si elle se
// construit, toutes les photos citées sont dans le dépôt. Une clé citée mais absente est signalée ici en rouge (elle arrêterait le build d'une vraie
// page). Non indexée (comme tout le site tant que data/site.json ne l'autorise pas), aucun lien vers elle : /dev/photos.
import Base from '../../layouts/Base.astro';
import ProjectPhoto from '../../components/ProjectPhoto.astro';
import { getCollection } from 'astro:content';
import { clesPhotos, fichierSource } from '../../lib/photos';

const ORDRE: Record<string, number> = { detailed: 0, agency: 1, gallery: 2 };
const projets = (await getCollection('projects')).sort((a, b) =>
  a.data.kind !== b.data.kind ? ORDRE[a.data.kind] - ORDRE[b.data.kind] : (a.data.order ?? 0) - (b.data.order ?? 0),
);
const citees = new Set(projets.flatMap((p) => p.data.selection ?? []));
const manquantes = [...citees].filter((c) => !fichierSource(c));
const nonCitees = clesPhotos.filter((c) => !citees.has(c));
---

<Base title="Contrôle des photos">
  <section class="container">
    <p class="resume">
      {projets.length} projets · {citees.size} photos citées · {clesPhotos.length} dans le dépôt
      {manquantes.length ? <strong class="manque"> · {manquantes.length} manquantes : {manquantes.join(', ')}</strong> : <> · aucune manquante</>}
    </p>
    {nonCitees.length > 0 && <p class="note">Dans le dépôt, citées par aucun projet : {nonCitees.join(', ')}</p>}

    {projets.map((p) => (
      <article>
        <h2>{p.data.name} <span class="meta">· {p.data.kind}{p.data.location ? ` · ${p.data.location}` : ''}</span></h2>
        <div class="grille">
          {(p.data.selection ?? []).map((cle) => (
            <figure>
              {fichierSource(cle) ? (
                <ProjectPhoto cle={cle} sizes="240px" largeurs={[320, 640]} />
              ) : (
                <div class="absente">absente</div>
              )}
              <figcaption>{cle}{fichierSource(cle) ? ` · ${fichierSource(cle)!.split('/').pop()}` : ''}</figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  .resume { font-size: 0.9rem; margin-block: 1.5rem 0.5rem; }
  .note { font-size: 0.8rem; color: var(--c-meta); margin-block: 0 1.5rem; }
  .manque { color: #b3261e; }
  article { margin-block-end: 2.5rem; }
  h2 { font-size: 1.05rem; font-weight: 600; margin-block-end: 0.5rem; }
  .meta { color: var(--c-meta); font-size: 0.8rem; font-weight: 400; }
  .grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; }
  figure { margin: 0; }
  figure :global(img) { display: block; width: 100%; height: auto; }
  .absente { aspect-ratio: 3 / 2; display: grid; place-items: center; border: 1px dashed #b3261e; color: #b3261e; font-size: 0.8rem; }
  figcaption { font-size: 0.7rem; color: var(--c-meta); margin-block-start: 0.25rem; word-break: break-all; }
</style>
