---
// Les projets de la vue Réalisations (styles : src/styles/realisations.css). Sur la grille large, une rangée de blocs par rangée de
// data/realisations.json (.alt__rang--<classe> : a, 7/12 et 5/12 ; b, 5/12 et 7/12 ; seul, toute la largeur), hauteur calée sur la fenêtre. Un projet à fiche (kind detailed) est un lien vers elle (./BlocLien.astro) ; un projet sans fiche (kind project), un album (./BlocAlbum.astro).
import BlocLien from './BlocLien.astro';
import BlocAlbum from './BlocAlbum.astro';

export interface BlocProjet {
  id: string;
  nom: string;
  /** Sa part de la rangée, en douzièmes. */
  part: number;
  /** Les clés de ses photos (selection) ; la première est celle du bloc. */
  photos: string[];
  focal: string;
  lieu: string;
  surface: string;
  usage?: string;
  projet?: string;
  /** Sans fiche : l'indice de son album dans la visionneuse ; à fiche : absent. */
  album?: number;
}

interface Props {
  rangees: { classe: string; blocs: BlocProjet[] }[];
}

const { rangees } = Astro.props;
---

<section class="large alt" id="projets" aria-label="Projets">
  {rangees.map((r) => <div class={`alt__rang alt__rang--${r.classe}`}>{r.blocs.map((b) => b.album === undefined
    ? <BlocLien id={b.id} nom={b.nom} part={b.part} photo={b.photos[0]} focal={b.focal} lieu={b.lieu} surface={b.surface} usage={b.usage} projet={b.projet} />
    : <BlocAlbum id={b.id} nom={b.nom} part={b.part} photos={b.photos} focal={b.focal} lieu={b.lieu} surface={b.surface} usage={b.usage} projet={b.projet} indice={b.album} />)}</div>)}
</section>
