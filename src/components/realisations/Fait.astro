---
// Un fait d'un bloc ou d'une tuile de la vue Réalisations : l'étiquette (.fait__et), puis la valeur (.fait__val). provisoire : un fait provisoire
// (« Projet » de Brosse, tant que son usage manque), signalé par la classe provisoire (sans effet visible) pour le retrouver dans le code.
interface Props {
  etiquette: string;
  valeur: string;
  provisoire?: boolean;
}

const { etiquette, valeur, provisoire = false } = Astro.props;
---

<span class={provisoire ? 'provisoire' : undefined}><span class="fait__et">{etiquette}</span><span class="fait__val">{valeur}</span></span>
