---
// Un fait d'un bloc ou d'une tuile de la vue Réalisations (lot 5, 05/10/2026) : mêmes balises et classes que fait() de design/maquette/src/build.mjs —
// l'étiquette (.fait__et), puis la valeur (.fait__val). provisoire : un fait provisoire (« Projet » de Brosse, tant que son usage manque), signalé comme
// dans la maquette par la classe provisoire et un title au survol.
interface Props {
  etiquette: string;
  valeur: string;
  provisoire?: boolean;
}

const { etiquette, valeur, provisoire = false } = Astro.props;
---

<span class={provisoire ? 'provisoire' : undefined} title={provisoire ? 'intitulé du site 2020, provisoire (lot 3)' : undefined}><span class="fait__et">{etiquette}</span><span class="fait__val">{valeur}</span></span>
