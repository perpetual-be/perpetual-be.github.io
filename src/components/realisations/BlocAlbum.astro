---
// Le bloc d'un projet sans fiche, vue Réalisations (lot 5, 05/10/2026 ; Brosse, kind project de data/projects.json) : mêmes balises et classes que
// blocSansFiche() de design/maquette/src/build.mjs, la maquette étant la référence (styles : src/styles/realisations.css). Le même bloc que les autres
// (div.bloc.bloc--album#<id>), mais un album (./Album.astro) : ses photos — son champ selection, dans l'ordre — se parcourent sur place et un clic ouvre la
// visionneuse sur la photo affichée. Le texte : le nom, les faits Lieu, Surface et Usage — « Projet », provisoire, tant que l'usage manque (Brosse : à
// demander à Julien) —, « lieu · surface » pour le téléphone. Nom accessible : « nom, lieu, surface — n photos ».
// Les photos, par ProjectPhoto, le sizes du bloc (sizesBloc, ./tailles.ts) : la n° 1 chargée tout de suite, avec son point focal (bloc.focal) ; les
// suivantes paresseuses. Sur toute la largeur, la n° 1 de Brosse est servie jusqu'à sa version de 2 362 px (brosse-31-l.jpg, la taille de l'original).
// Texte alternatif (lot 7, src/lib/alt.ts) : la légende de la photo, sinon « nom, lieu » (« Brosse, Forest »).
import Album from './Album.astro';
import Fait from './Fait.astro';
import { sizesBloc } from './tailles';
import { texteAlternatif, nomEtLieu } from '../../lib/alt';

interface Props {
  id: string;
  nom: string;
  /** La part du bloc dans sa rangée, en douzièmes. */
  part: number;
  /** Les clés des photos, dans l'ordre ; la première est celle du bloc. */
  photos: string[];
  focal: string;
  lieu: string;
  surface: string;
  usage?: string;
  /** Le troisième fait, provisoire, tant que usage manque. */
  projet?: string;
  /** L'indice de l'album dans ceux de la visionneuse. */
  indice: number;
}

const { id, nom, part, photos, focal, lieu, surface, usage, projet, indice } = Astro.props;
const vues = await Promise.all(photos.map(async (cle, i) => ({ cle, sizes: await sizesBloc(cle, part), focal: i === 0 ? focal : undefined, loading: i === 0 ? 'eager' as const : 'lazy' as const, alt: texteAlternatif(cle, nomEtLieu(nom, lieu)) })));
const n = photos.length;
---

<Album classe="bloc bloc--album" id={id} indice={indice} label={`${nom}, ${lieu}, ${surface} — ${n} photo${n > 1 ? 's' : ''}`} photos={vues}><span class="bloc__texte" aria-hidden="true"><span class="bloc__nom">{nom}</span><span class="bloc__faits"><Fait etiquette="Lieu" valeur={lieu} /><Fait etiquette="Surface" valeur={surface} />{usage ? <Fait etiquette="Usage" valeur={usage} /> : <Fait etiquette="Projet" valeur={projet!} provisoire />}</span><span class="bloc__mobile">{`${lieu} · ${surface}`}</span></span></Album>
