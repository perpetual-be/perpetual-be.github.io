---
// Le projet précédent et le suivant, au bas d'une fiche projet (lot 5, 05/10/2026) : mêmes balises et classes que fichePage() de
// design/maquette/src/build.mjs, la maquette étant la référence (styles : src/styles/fiche.css). Sur la grille large, un filet au-dessus : « Projet
// précédent » (← nom, à gauche) et « Projet suivant » (nom →, à droite), en serif or foncé, liens vers /realisations/<id>. La page les choisit en boucle
// dans l'ordre du champ order de data/projects.json (The Bank → Data Box → Community → Ateliers 118 → The Bank).
interface Props {
  prec: { id: string; nom: string };
  suiv: { id: string; nom: string };
}

const { prec, suiv } = Astro.props;
---

<div class="large"><nav class="fiche__voisins" aria-label="Autres projets"><a class="fiche__voisin fiche__voisin--prec" href={`/realisations/${prec.id}`}><span class="eyebrow">Projet précédent</span><span class="suivant__nom trait">{`← ${prec.nom}`}</span></a><a class="fiche__voisin fiche__voisin--suiv" href={`/realisations/${suiv.id}`}><span class="eyebrow">Projet suivant</span><span class="suivant__nom trait">{`${suiv.nom} →`}</span></a></nav></div>
