---
// Premier écran de la Home (styles : src/styles/home.css). La photo pleine largeur (content/home.md, hero : clé et point focal, affichée par
// ProjectPhoto) porte l'accroche en blanc ; la bande des quatre chiffres avec les anneaux vient juste après la photo (le CSS la remonte, .hero__grid
// est en display: contents), puis les paragraphes en deux colonnes — le premier à gauche, les suivants à droite avec la signature dessous. Les
// textes sont insérés tels quels (texte brut, pas de rendu Markdown).
import ProjectPhoto from '../ProjectPhoto.astro';
import { formatPhoto } from '../../lib/photos';

interface Props {
  h1: string;
  paragraphs: string[];
  signature: string;
  stats: { value: string; label: string }[];
  hero: { photo: string; focal?: string };
}

const { h1, paragraphs, signature, stats, hero } = Astro.props;
// sizes de la photo : au-dessus de 640 px, elle couvre la largeur de la fenêtre (100vw) ; au téléphone, elle fait 420 px de haut (src/styles/home.css)
// et, recadrée en cover, s'affiche sur 420 px × son format de large — 560 px pour une photo 4:3 —, plus large que la fenêtre jusqu'à cette largeur.
// Avec 100vw partout, un téléphone 3× de 390 px chargerait la version de 1 200 px pour 560 × 3 px affichés.
const HAUTEUR_TELEPHONE = 420;
const largeurTelephone = Math.round(HAUTEUR_TELEPHONE * (await formatPhoto(hero.photo)));
const sizesPhoto = `(max-width: ${Math.min(largeurTelephone, 640)}px) ${largeurTelephone}px, 100vw`;
---

<section class="hero">
<div class="hero__photo" aria-hidden="true"><ProjectPhoto cle={hero.photo} focal={hero.focal} sizes={sizesPhoto} loading="eager" fetchpriority="high" alt="" /></div>
<div class="container hero__grid">
  <h1 class="hero__title"><span set:html={h1} /></h1>
  <div class="hero__text"><p set:html={paragraphs[0]} /><div class="hero__col">{paragraphs.slice(1).map((p) => <p set:html={p} />)}<p class="signature" set:html={signature} /></div></div>
</div>
<section class="band stats-band" aria-label="Chiffres clés"><div class="deco" aria-hidden="true">
    <svg class="deco__svg deco--anneaux" viewBox="0 0 420 220" preserveAspectRatio="xMaxYMid meet"><circle cx="270" cy="110" r="110" fill="none" stroke="currentColor" stroke-width="1"/><circle class="deco__2" cx="270" cy="110" r="150" fill="none" stroke="currentColor" stroke-width="1"/></svg>
  </div><div class="container"><ol class="stats">{stats.map((s) => <li class="stat"><span class="stat__value">{s.value}</span><span class="stat__label">{s.label}</span></li>)}</ol></div></section>
</section>
