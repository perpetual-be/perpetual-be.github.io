---
// Premier écran de la Home (structure F, figée le 23/09 ; lot 4, 01/10/2026) : mêmes balises et classes que lead(), deco() et statsList() de
// design/maquette/src/build.mjs, la maquette étant la référence (styles : src/styles/home.css). La photo pleine largeur (content/home.md, hero :
// clé et point focal, affichée par ProjectPhoto) porte l'accroche en blanc ; la bande des quatre chiffres avec les anneaux vient juste après la
// photo (le CSS la remonte, .hero__grid est en display: contents), puis les paragraphes en deux colonnes — le premier à gauche, les suivants à
// droite avec la signature dessous. Les textes sont insérés tels quels, comme build.mjs (texte brut, pas de rendu Markdown).
import ProjectPhoto from '../ProjectPhoto.astro';

interface Props {
  h1: string;
  paragraphs: string[];
  signature: string;
  stats: { value: string; label: string }[];
  hero: { photo: string; focal?: string };
}

const { h1, paragraphs, signature, stats, hero } = Astro.props;
---

<section class="hero">
<div class="hero__photo" aria-hidden="true"><ProjectPhoto cle={hero.photo} focal={hero.focal} sizes="100vw" loading="eager" fetchpriority="high" alt="" /></div>
<div class="container hero__grid">
  <h1 class="hero__title"><span set:html={h1} /></h1>
  <div class="hero__text"><p set:html={paragraphs[0]} /><div class="hero__col">{paragraphs.slice(1).map((p) => <p set:html={p} />)}<p class="signature" set:html={signature} /></div></div>
</div>
<section class="band stats-band" aria-label="Chiffres clés"><div class="deco" aria-hidden="true">
    <svg class="deco__svg deco--anneaux" viewBox="0 0 420 220" preserveAspectRatio="xMaxYMid meet"><circle cx="270" cy="110" r="110" fill="none" stroke="currentColor" stroke-width="1"/><circle class="deco__2" cx="270" cy="110" r="150" fill="none" stroke="currentColor" stroke-width="1"/></svg>
  </div><div class="container"><ol class="stats">{stats.map((s) => <li class="stat"><span class="stat__value">{s.value}</span><span class="stat__label">{s.label}</span></li>)}</ol></div></section>
</section>
