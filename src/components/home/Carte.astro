---
// Section « Réalisations » de la Home : la carte des réalisations (data/carte/, src/lib/carte.ts) avec le texte à droite. L'eyebrow est le libellé de
// l'entrée /realisations de data/site.json ; le titre et le paragraphe viennent de l'en-tête carte de content/home.md, insérés tels quels.
import site from '../../../data/site.json';
import { carteSvg } from '../../lib/carte';

interface Props {
  titre: string;
  texte: string;
}

const { titre, texte } = Astro.props;
const realisations = site.nav.find((n) => n.href === '/realisations');
if (!realisations) throw new Error('data/site.json : entrée de navigation /realisations introuvable');
---

<section class="section section--autres" id="realisations">
<div class="container">
  <p class="eyebrow">{realisations.label}</p>
  <div class="carte">
    <div class="carte__fig" set:html={carteSvg()} />
    <div class="carte__texte">
      <h2 class="h2 h2--serif">{titre}</h2>
      <p set:html={texte} />
      <a class="autres__lien trait" href="/realisations">Toutes les réalisations →</a>
    </div>
  </div>
</div>
</section>
