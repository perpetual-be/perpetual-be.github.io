---
// Section « Réalisations » de la Home (lot 4, 01/10/2026) : la carte des réalisations (data/carte/, src/lib/carte.ts) avec le texte à droite — mêmes
// balises et classes que autres() de design/maquette/src/build.mjs. L'eyebrow est le libellé de l'entrée /realisations de data/site.json ; le titre est
// calculé (titreCarte) ; le paragraphe est celui du programme agences (content/realisations.md), inséré tel quel comme build.mjs.
import site from '../../../data/site.json';
import { carteSvg, titreCarte } from '../../lib/carte';

interface Props {
  agences: string;
}

const { agences } = Astro.props;
const realisations = site.nav.find((n) => n.href === '/realisations');
if (!realisations) throw new Error('data/site.json : entrée de navigation /realisations introuvable');
const titre = await titreCarte();
---

<section class="section section--autres" id="realisations">
<div class="container">
  <p class="eyebrow">{realisations.label}</p>
  <div class="carte">
    <div class="carte__fig" set:html={carteSvg()} />
    <div class="carte__texte">
      <h2 class="h2 h2--serif">{titre}</h2>
      <p set:html={agences} />
      <a class="autres__lien trait" href="/realisations">Toutes les réalisations →</a>
    </div>
  </div>
</div>
</section>
