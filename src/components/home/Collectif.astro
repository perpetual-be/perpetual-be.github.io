---
// Section Collectif de la Home (lot 4, 01/10/2026) : les paragraphes et la chute de content/collectif.md (insérés tels quels, comme build.mjs), puis les
// logos partenaires — mêmes balises et classes que collectifBlock() et partnersHtml de design/maquette/src/build.mjs. Logos figés en couleur (22/09) :
// data/partners.json, fichiers de public/partners/couleur/. La hauteur de chaque logo se calcule à la masse visuelle sur le viewBox du fichier encre
// (mêmes canevas, 100 de haut ; partnerHeight() de build.mjs) : 34 px × √(291 / largeur du viewBox), bornée 34–60 px (Batopin, 291 de large, est
// l'étalon à 34 px), posée en --logo-h sur le <li>.
import partners from '../../../data/partners.json';

interface Props {
  paragraphs: string[];
  chute: string;
}

const { paragraphs, chute } = Astro.props;
const encre = import.meta.glob('../../../public/partners/encre/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
function partnerHeight(logoInk: string | undefined, nom: string): number {
  const fichier = logoInk?.split('/').pop();
  const svg = fichier && encre[Object.keys(encre).find((k) => k.endsWith('/' + fichier)) ?? ''];
  if (!svg) throw new Error(`data/partners.json : ${nom} — logoInk (public/partners/encre/) introuvable, il donne la hauteur du logo`);
  const w = Number(svg.match(/viewBox="0 0 ([\d.]+) 100"/)?.[1]);
  if (!w) throw new Error(`public/partners/encre/${fichier} : viewBox « 0 0 <largeur> 100 » attendu`);
  return Math.min(60, Math.max(34, Math.round(34 * Math.sqrt(291 / w))));
}
---

<section class="section section--collectif" id="collectif"><div class="container">
  <p class="eyebrow">Collectif</p>
  <div class="collectif__text">{paragraphs.map((p) => <p set:html={p} />)}<p class="chute" set:html={chute} /></div>
  <ul class="partners" aria-label="Partenaires">
{partners.map((p) => <li class="partner" style={`--logo-h:${partnerHeight(p.logoInk, p.name)}px`} title={p.name}><img class="partner__couleur" src={p.logo} alt={p.name} loading="lazy" /></li>)}
  </ul>
</div></section>
